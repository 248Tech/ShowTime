# ShowTime configuration. Copy to ".env" - every setting is optional.
# Lines starting with # are examples; remove the # to enable.

# --- network ---------------------------------------------------------------
PORT=8080
HOST=127.0.0.1                 # 0.0.0.0 to serve your LAN (see docs/DEPLOYMENT.md - use HTTPS for chat & P2P features)
#PUBLIC_URL=https://show.example.com   # used in password-reset emails
#TRUST_PROXY=1                 # ONLY when behind a proxy/tunnel you control (Caddy, nginx, Tailscale Funnel, Cloudflare)
#TLS_CERT=/path/to/fullchain.pem        # or terminate TLS in a proxy instead
#TLS_KEY=/path/to/privkey.pem

# --- storage ---------------------------------------------------------------
#DATA_DIR=./data               # database + encrypted vault + master.key  (BACK THIS UP)
#SHOWTIME_MASTER_KEY=<64 hex chars>     # otherwise data/master.key is generated on first run
#MEDIA_DIRS=/mnt/movies:/mnt/tv         # read-only library folders (use ; as the separator on Windows: D:\Movies;D:\TV)
#MAX_UPLOAD_GB=50

# --- password-reset email (without SMTP, reset links are printed to the server console) ---
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURE=0                 # 1 for port 465
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM="ShowTime <noreply@example.com>"

# --- media processing ------------------------------------------------------
#FFMPEG=ffmpeg
#FFPROBE=ffprobe
#ENCODE_AUTO=1                 # scan new uploads and encode AV1/VP9/H.264 versions in the background (0 = off; admins can also toggle it)
#ENCODE_BUDGET_X=2             # an encode may take at most this many times the video's runtime
#AV2_ENCODER=                  # an FFmpeg AV2 encoder name, once one exists

# --- live TV ---------------------------------------------------------------
#IPTV_AUTO=1                   # import + health-check the channel list on start and daily (0 = off)
#IPTV_SOURCE_URL=https://iptv-org.github.io/iptv/index.m3u   # or point at your own M3U

# --- peer-to-peer local-file streaming -------------------------------------
#ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]       # add a TURN server for viewers behind strict NATs

# --- chat ------------------------------------------------------------------
#CHAT_WIPE_MS=172800000        # chat wipe interval in ms (default 48h)
